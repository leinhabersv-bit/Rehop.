{
  "version": "1.1",
  "mode": "simulated_ondc_shaped_not_network_connected",
  "providers": [
    "PROVIDER_A",
    "PROVIDER_B",
    "PROVIDER_C",
    "PROVIDER_D"
  ],
  "facade_to_beckn": {
    "get_quotes": [
      "search",
      "on_search"
    ],
    "select_candidate": [
      "select",
      "on_select"
    ],
    "prepare_booking": [
      "init",
      "on_init"
    ],
    "book": [
      "confirm",
      "on_confirm"
    ],
    "cancel": [
      "cancel",
      "on_cancel"
    ],
    "get_ride_state": [
      "status",
      "on_status",
      "track",
      "on_track"
    ]
  },
  "local_signatures": {
    "search": "search(journey_id, now, distance_km) -> Quote",
    "select": "select(quote, now) -> bool",
    "init": "init(quote, now) -> bool",
    "confirm": "confirm(quote, now, ride) -> OperationResult",
    "cancel": "cancel(ride_id) -> OperationResult",
    "status": "status(ride_id) -> RideStatus | None",
    "track": "track(ride) -> RideTracking"
  },
  "note": "The local simulator is synchronous; real network semantics are authenticated asynchronous requests/callbacks."
}
