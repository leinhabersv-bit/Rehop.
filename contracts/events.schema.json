{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/riderescue/events.schema.json",
  "title": "RideRescue Journey Event Envelope v1.1",
  "description": "All providers and telemetry are simulated; sequence numbers are per journey.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "journey_id",
    "seq",
    "timestamp",
    "type",
    "ride_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ride_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "APPROVAL_REQUIRED",
        "BACKUP_FOUND",
        "BOOKING_REQUESTED",
        "DEADLINE_DECISION",
        "DRIVER_ARRIVED",
        "DRIVER_CANCELLED",
        "DRIVER_MESSAGE_CLASSIFIED",
        "ERROR",
        "EXPLANATION_VERIFIED",
        "JOURNEY_CREATED",
        "PICKUP_CONFIRMED",
        "QUOTES_READY",
        "QUOTE_REFRESHED",
        "QUOTE_REFRESH_FAILED",
        "RECONCILIATION_REQUIRED",
        "RECONCILED",
        "RECOVERY_CHECKED",
        "RECOVERY_BLOCKED",
        "RECOVERY_EXHAUSTED",
        "RECOVERY_STARTED",
        "RECOVERY_SUCCEEDED",
        "REPLACEMENT_QUOTE_LOST",
        "RIDE_CANCEL_CONFIRMED",
        "RIDE_CANCEL_REQUESTED",
        "RIDE_CONFIRMED",
        "RISK_SIGNAL_ADDED",
        "RISK_UPDATED",
        "SWITCH_APPROVED",
        "SWITCH_REJECTED",
        "TELEMETRY_UPDATED",
        "USER_CANCELLED"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "RECONCILIATION_REQUIRED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "reason",
              "step"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "OUTCOME_UNKNOWN",
                  "VERIFICATION_REQUIRED"
                ]
              },
              "step": {
                "enum": [
                  "primary",
                  "replacement",
                  "switch_cancel",
                  "user_cancel"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "RECONCILED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "outcome",
              "step"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "CONFIRMED",
                  "DRIVER_EN_ROUTE",
                  "DRIVER_ARRIVED",
                  "IN_PROGRESS",
                  "COMPLETED",
                  "DRIVER_CANCELLED",
                  "RIDER_CANCELLED",
                  "FAILED"
                ]
              },
              "step": {
                "enum": [
                  "primary",
                  "replacement",
                  "switch_cancel",
                  "user_cancel"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "RECOVERY_CHECKED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "step"
            ],
            "properties": {
              "step": {
                "enum": [
                  "version",
                  "limits"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"type": {"const": "RISK_UPDATED"}}
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "signal_details": {
                "description": "Optional numeric evidence. Points are signed adjustments to the risk score.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["code", "value", "threshold", "points"],
                  "properties": {
                    "code": {"type": "string"},
                    "value": {"type": ["number", "string"]},
                    "threshold": {"type": ["number", "string"]},
                    "points": {"type": "integer"}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "DRIVER_MESSAGE_CLASSIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "signal": {
                "description": "Advisory driver chat classification. LLM metadata is optional for older events.",
                "properties": {
                  "eta_claim_min": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 120
                  },
                  "confidence": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "model": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "latency_ms": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "Completion elapsed time. Zero for deterministic offline results."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "DEADLINE_DECISION"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "decision_type": {
                "enum": [
                  "MONITOR",
                  "SEARCH_BACKUP",
                  "REQUEST_APPROVAL",
                  "REBOOK_AFTER_CANCEL",
                  "STOP"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "numbers": {
                "type": "object",
                "required": [
                  "wait_late_sec",
                  "switch_late_sec",
                  "wait_cost",
                  "switch_cost",
                  "seconds_until_need_by"
                ],
                "properties": {
                  "wait_late_sec": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "switch_late_sec": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "wait_cost": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "switch_cost": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "seconds_until_need_by": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
